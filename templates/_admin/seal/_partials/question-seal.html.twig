<div class="seal-form-container">
    <div class="text-center mb-4">
        <h3 class="form-title fw-bold text-primary mb-1">
            <i class="bi bi-award me-2"></i>{{ 'view.seal.create' | trans }}
        </h3>
        <p class="text-muted small">Preencha os dados abaixo para cadastrar o selo.</p>
    </div>

    <form method="POST" action="{{ path('admin_seal_add') }}">
        <input type="hidden" name="token" value="{{ csrf_token(form_id) }}">

        <div class="form-floating mb-4">
            <input type="text" class="form-control" id="name" name="name" placeholder="{{ 'name' | trans }}" required>
            <label for="name">{{ 'seal_name' | trans }}</label>
        </div>

        <div class="form-floating mb-4">
            <textarea class="form-control" id="description" name="description" style="height: 130px" maxlength="500" placeholder="{{ 'description' | trans }}" required></textarea>
            <label for="description">{{ 'description' | trans }}</label>
        </div>

        <div class="d-grid gap-3 d-md-flex justify-content-md-center mt-4">
            <a href="{{ path('admin_seal_list') }}" class="btn btn-outline-secondary px-4 py-2 fw-semibold rounded-pill">
                <i class="bi bi-arrow-left me-1"></i> {{ 'cancel' | trans }}
            </a>
            <button class="btn btn-primary px-5 py-2 fw-semibold rounded-pill" type="submit">
                {{ 'save' | trans }} <i class="bi bi-check2 ms-1"></i>
            </button>
        </div>
    </form>
</div>
